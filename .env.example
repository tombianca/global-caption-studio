# =====================================================================
# Global Caption Studio — environment configuration
# Copy to `.env` and fill in what you need. The app runs fully in
# "mock mode" with ONLY the DATABASE_URL set — no API keys required.
# =====================================================================

# --- Database ---------------------------------------------------------
# PostgreSQL (production / via docker-compose)
DATABASE_URL=postgresql://gcs:gcs@localhost:5432/gcs?schema=public
# SQLite fallback for zero-infrastructure local development:
#   npm run db:switch:sqlite  (then)  DATABASE_URL="file:./dev.db"
# Set DATABASE_URL to "file:./dev.db" and use the sqlite schema to run
# without Docker/Postgres.

# --- Auth -------------------------------------------------------------
# Long random string used to sign session JWTs (required in production).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Google OAuth (optional — "Continue with Google" is hidden when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- File storage (S3-compatible) -------------------------------------
# Leave STORAGE_ENDPOINT empty to use local filesystem storage (dev mode).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# --- Speech-to-text ---------------------------------------------------
# TRANSCRIPTION_PROVIDER:
#   local = run Whisper locally in Node (no API key, downloads ~75MB model on first use)
#   mock  = placeholder captions (instant, for demos only)
#   api   = a Whisper-compatible HTTP API (set TRANSCRIPTION_API_KEY)
TRANSCRIPTION_PROVIDER=local
TRANSCRIPTION_LOCAL_MODEL=Xenova/whisper-base.en
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# --- Translation ------------------------------------------------------
# TRANSLATION_PROVIDER: mock | deepl | google
# Leave TRANSLATION_API_KEY empty (or provider=mock) to use the mock translator.
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
DEEPL_BASE_URL=https://api-free.deepl.com/v2
GOOGLE_TRANSLATION_API_KEY=

# --- Background jobs ---------------------------------------------------
# Leave REDIS_URL empty to use the built-in in-process job queue (dev).
REDIS_URL=

# --- Limits & FFmpeg ----------------------------------------------------
MAX_UPLOAD_SIZE_MB=2048
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Misc ---------------------------------------------------------------
PORT=3000
